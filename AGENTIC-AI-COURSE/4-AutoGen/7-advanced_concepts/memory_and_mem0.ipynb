class MemoryRAGAgent(AssistantAgent):
    def __init__(self, name, memory_instance, rag_system, **kwargs):
        super().__init__(name, **kwargs)
        self.memory = memory_instance
        self.rag = rag_system
        self.user_id = name  # Use agent name as user ID for memory
    
    def generate_reply(self, messages, sender, config=None):
        # Get the last message
        last_message = messages[-1]['content'] if messages else ""
        
        # Search for relevant documents using RAG
        relevant_docs = self.rag.search(last_message, top_k=2)
        context = "\n".join([doc['content'] for doc in relevant_docs])
        
        # Retrieve relevant memories
        memories = self.memory.search(last_message, user_id=self.user_id)
        memory_context = "\n".join([mem['memory'] for mem in memories]) if memories else ""
        
        # Enhance the message with context
        enhanced_message = f"""
        Context from knowledge base:
        {context}
        
        Relevant memories:
        {memory_context}
        
        User message: {last_message}
        """
        
        # Create enhanced messages list
        enhanced_messages = messages[:-1] + [{"role": "user", "content": enhanced_message}]
        
        # Generate reply using parent method
        reply = super().generate_reply(enhanced_messages, sender, config)
        
        # Store the interaction in memory
        if last_message and reply:
            self.memory.add(
                f"User asked: {last_message}. I responded: {reply}",
                user_id=self.user_id
            )
        
        return reply

