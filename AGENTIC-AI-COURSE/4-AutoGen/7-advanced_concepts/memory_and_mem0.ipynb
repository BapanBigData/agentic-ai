class SimpleRAG:
    def __init__(self):
        self.documents = [
            {
                "id": "doc1",
                "content": "Python is a high-level programming language known for its simplicity and readability. It's widely used in data science, web development, and automation.",
                "metadata": {"topic": "programming", "language": "python"}
            },
            {
                "id": "doc2", 
                "content": "Machine learning is a subset of artificial intelligence that enables computers to learn and make decisions from data without being explicitly programmed.",
                "metadata": {"topic": "AI", "field": "machine_learning"}
            },
            {
                "id": "doc3",
                "content": "AutoGen is a Microsoft framework for building multi-agent conversational AI systems. It allows multiple AI agents to collaborate and communicate.",
                "metadata": {"topic": "AI", "framework": "autogen"}
            },
            {
                "id": "doc4",
                "content": "Vector databases store data as high-dimensional vectors, enabling efficient similarity search and retrieval for AI applications like RAG systems.",
                "metadata": {"topic": "database", "type": "vector"}
            }
        ]
        self.embedder = SentenceTransformer('all-MiniLM-L6-v2')
        self._create_embeddings()
    
    def _create_embeddings(self):
        """Create embeddings for all documents"""
        for doc in self.documents:
            doc["embedding"] = self.embedder.encode(doc["content"])
    
    def search(self, query: str, top_k: int = 2) -> List[Dict]:
        """Search for relevant documents"""
        query_embedding = self.embedder.encode(query)
        
        # Calculate similarities
        similarities = []
        for doc in self.documents:
            similarity = np.dot(query_embedding, doc["embedding"]) / (
                np.linalg.norm(query_embedding) * np.linalg.norm(doc["embedding"])
            )
            similarities.append((similarity, doc))
        
        # Sort by similarity and return top_k
        similarities.sort(key=lambda x: x[0], reverse=True)
        return [doc for _, doc in similarities[:top_k]]

# Initialize RAG system
rag_system = SimpleRAG()
print("RAG system initialized with dummy documents!")# Setup mem0 memory system and imports
from mem0 import Memory
import autogen
from autogen import ConversableAgent, AssistantAgent, UserProxyAgent
import chromadb
from sentence_transformers import SentenceTransformer
import numpy as np
from typing import List, Dict, Any
import json

# Initialize mem0 memory
config = {
    "vector_store": {
        "provider": "chroma",
        "config": {
            "collection_name": "autogen_memory",
            "path": "./chroma_db"
        }
    },
    "embedder": {
        "provider": "sentence_transformers",
        "config": {
            "model": "all-MiniLM-L6-v2"
        }
    }
}

# Create memory instance
memory = Memory.from_config(config)
print("Memory system initialized successfully!")